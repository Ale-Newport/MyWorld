{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker that serves the whole site (OpenNext for Cloudflare). Build and
  // deploy with `npm run deploy`, or let Workers Builds run `npm run cf:build`.
  "name": "alejandro-newport-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The repository the deployed admin commits its settings to (needs the GITHUB_TOKEN secret).
  "vars": { "GITHUB_REPO": "Ale-Newport/MyWorld" },
  "limits": { "cpu_ms": 30000 },
  // Run the Worker near its database (Supabase) when most of a request is waiting on it.
  "placement": { "mode": "smart" },
  // Pooled connections to Supabase through Hyperdrive (session-mode pooler, port 5432; caching off, so a publish shows at once).
  // src/server/db.ts uses the binding when present, else the DATABASE_URL secret.
  // localConnectionString is a placeholder for local tooling (OpenNext's deploy step needs one); it is never deployed.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "79ba8d775dbb4305a2f6742b5a3cd39b", "localConnectionString": "postgresql://local:local@127.0.0.1:5432/local" }]
}
