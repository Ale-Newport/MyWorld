# Normalise text to LF in the repository and in every checkout, on every OS.
* text=auto eol=lf

# Binary assets: never diffed or converted.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.glb    binary
*.gz     binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.mp4    binary
*.webm   binary
*.wasm   binary

# Lockfile: resolve conflicts by regenerating it, not by merging lines.
package-lock.json -diff linguist-generated=true

# Generated byte-for-byte from HelloWorld; audited using release.json hashes.
public/archipelago/** linguist-generated=true -whitespace
# Generated from Simple Icons by scripts/gen-tech-logos.mjs.
src/content/tech-logos.ts linguist-generated=true
