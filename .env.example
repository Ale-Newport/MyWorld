# No secrets are required to run this site — everything it displays is
# static content from src/content/. This file exists only for the two
# optional values below.

# Public site origin. Used for OpenGraph URLs, the canonical link and
# sitemap.xml. Also set `siteConfig.url` in src/content/profile.ts.
NEXT_PUBLIC_SITE_URL=https://alejandronewport.com

# Optional analytics id. Nothing reads this yet; wire it up in
# src/app/layout.tsx if you add analytics.
# NEXT_PUBLIC_ANALYTICS_ID=
