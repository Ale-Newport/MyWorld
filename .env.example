# Environment for the portfolio and its admin. Nothing here is ever sent to the
# browser. Never commit real values: copy this file to .env.local for development;
# in production set them on the Cloudflare Worker (Settings → Variables and Secrets,
# or `npx wrangler secret put NAME`), as Secrets.

# --- Production content store (Supabase) ------------------------------------
# Postgres connection string: Supabase → Connect → "Transaction pooler" (port 6543),
# with the database password filled in. Unset = local SQLite in CMS_DATA_DIR.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project URL and SERVICE-ROLE (secret) key, for the private storage
# bucket that holds world documents and uploads. Server-side only.
# Unset = files on disk in CMS_DATA_DIR.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
# Optional; defaults to "cms" (created by supabase/migrations).
# SUPABASE_STORAGE_BUCKET=cms

# --- Always -------------------------------------------------------------------
# 32+ random characters. Salts the daily audience visitor key (see
# src/server/analytics.ts). Required in production. Generate one with:
#   openssl rand -base64 48
CMS_SECRET=

# --- Development only -----------------------------------------------------------
# Where the local store lives (SQLite + files). Default: .data/cms (git-ignored).
# CMS_DATA_DIR=

# Only for creating an administrator unattended. Normally leave unset and run
# `npm run admin:create`, which asks for the password without echoing it.
# ADMIN_PASSWORD=
