# Environment for the portfolio and its admin. Copy to .env.local for
# development; in production set these in the host's environment.
# Nothing here is ever sent to the browser.

# Where the content store lives: the SQLite database (documents, revisions,
# users, sessions, audit log, media index, audience events), world files and
# uploads. Development default: .data/cms (git-ignored). In production this
# must be a PERSISTENT directory (a volume), or admin edits are lost.
CMS_DATA_DIR=

# 32+ random characters. Salts the daily audience visitor key (see
# src/server/analytics.ts). Required in production: without it nothing is
# recorded. Generate one with:  openssl rand -base64 48
CMS_SECRET=

# Only for creating the first administrator unattended (a container's first
# boot). Normally leave this unset and run `npm run admin:create`, which asks
# for the password without echoing it. Never commit a real value.
# ADMIN_PASSWORD=
