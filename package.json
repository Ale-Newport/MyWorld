{
  "name": "alejandro-newport-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "world:seed": "node scripts/world/build-seed.mjs",
    "predev": "npm run world:seed --silent",
    "dev": "next dev",
    "editor:install": "node scripts/editor/service.mjs install",
    "editor:update": "node scripts/editor/service.mjs update",
    "editor:status": "node scripts/editor/service.mjs status",
    "editor:uninstall": "node scripts/editor/service.mjs uninstall",
    "dev:site": "npm run world:seed --silent && CMS_SHOW_SITE=1 next dev",
    "prebuild": "npm run world:seed --silent",
    "build": "next build",
    "start": "next start",
    "cf:build": "npm run world:seed --silent && opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "preview": "npm run world:seed --silent && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run world:seed --silent && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run world:seed --silent",
    "test": "node --test --no-warnings \"tests/**/*.test.mjs\"",
    "content:status": "node scripts/content-status.mjs",
    "capture:clients": "node scripts/capture-clients.mjs",
    "qa": "node scripts/visual-qa.mjs",
    "perf": "node scripts/perf-check.mjs",
    "world:layout": "node scripts/world-layout-check.mjs",
    "world:decor": "node scripts/world-decor-check.mjs",
    "world:glyphs": "node scripts/gen-title-glyphs.mjs",
    "admin:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/admin/create-admin.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.8",
    "meshoptimizer": "~1.1.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "simple-icons": "^16.30.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
